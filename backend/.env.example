# Aivira Backend Environment Configuration
# Copy this file to .env and configure your production credentials.

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Gnani AI (Prisma v2.5 STT & Timbre v2.5 TTS)
GNANI_API_KEY=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/sse

# Supabase (PostgreSQL, Auth & Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Firebase Cloud Messaging (FCM)
FIREBASE_PROJECT_ID=AiVira
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_FILE=

# Agora (Reserved for Future Calling Module - Do Not Expose in Frontend)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Application
HOST=0.0.0.0
PORT=8000
DEBUG=True
JWT_SECRET=your-jwt-secret-key-change-in-production

